.venv/
venv/
env/
ENV/

# Invoice PDF & Image Uploads (Keeps directory structure with .gitkeep)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
frontend/uploads/*
!frontend/uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep

# FAISS / Local Vector Data
data/*
!data/.gitkeep
backend/data/*
!backend/data/.gitkeep
**/data/*
!**/data/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

