# ==============================================================================
# ENVIRONMENT & GENERAL CONFIG
# ==============================================================================
# Options: development, staging, production
ENVIRONMENT=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoices

# JWT Secret & Security
SECRET_KEY=super-secret-key-change-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# LLM PROVIDER CONFIGURATION (Google Gemini / Ollama)
# ==============================================================================
# Options: gemini, ollama
LLM_PROVIDER=gemini

# Google Gemini Settings
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Ollama Local Settings (used when LLM_PROVIDER=ollama or as fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ==============================================================================
# VECTOR STORE CONFIGURATION (FAISS for Local, Pinecone for Production)
# ==============================================================================
# Options: auto (faiss in development, pinecone in production), faiss, pinecone
VECTOR_STORE_PROVIDER=auto

# FAISS Local Storage Directory
FAISS_INDEX_DIR=./data/faiss_index

# Pinecone Production Settings (Required when VECTOR_STORE_PROVIDER=pinecone or ENVIRONMENT=production)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=invoice-validation
PINECONE_ENVIRONMENT=us-east-1

# ==============================================================================
# OCR & DOCUMENT EXTRACTION
# ==============================================================================
# Options: gemini_vision, ollama_vision, text_extractor
OCR_ENGINE=gemini_vision
MAX_DOCUMENT_PAGES=10
